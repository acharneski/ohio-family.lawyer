<div class="wrap">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/resources/">Resources</a></li><li aria-current="page">Counties</li></ol></nav>
  <header class="page-header">
    <h1>Family court resources by county</h1>
    <p class="lede">{{ summary }}</p>
    <p class="fine-print">County pages marked "Verified" have court and agency links checked by our editors. Others are in progress.</p>
  </header>

  <ul class="county-grid">
    {% for c in counties %}
      <li><a href="/resources/counties/{{ c.name | toSlug }}/">{{ c.name }} County</a>{% if c.ready %} <span class="pill">Verified</span>{% endif %}</li>
    {% endfor %}
  </ul>
</div>