  size: 1
  alias: county
permalink: "/resources/counties/{{ county.name | toSlug }}/"
eleventyComputed:
  title: "{{ county.name }} County, Ohio: family court resources"
  seoTitle: "{{ county.name }} County, Ohio Custody & Child Support Help"
  summary: "Where custody, parenting-time, child support, and protection-order cases are heard in {{ county.name }} County, Ohio, and where to find free and low-cost help."
---
<article class="wrap page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol><li><a href="/resources/">Resources</a></li><li><a href="/resources/counties/">Counties</a></li><li aria-current="page">{{ county.name }}</li></ol>
  </nav>

  <header class="page-header">
    <p class="eyebrow">Ohio · {{ county.name }} County</p>
    <h1>{{ county.name }} County family court resources</h1>
    <p class="lede">{{ summary }}</p>
  </header>

  {% if not county.ready %}
      <p class="notice notice--warn"><strong>In progress.</strong> Links to the {{ county.name }} County domestic relations court, juvenile court, local rules, and CSEA will be added once someone checks them against official sources. Until then, confirm details with the county clerk of courts. <strong>Know this county?</strong> <a href="{{ 'src/_data/counties.json' | editUrl }}" rel="noreferrer">Help verify it on GitHub</a> (see <a href="/contribute/">how to contribute</a>).</p>
  {% endif %}

  <div class="prose">
    {% if county.domestic_relations_url or county.juvenile_url or county.csea_url or county.local_rules_url %}
      <h2 id="contacts">Courts and agencies</h2>
      <ul>
        {% if county.domestic_relations_url %}<li><a href="{{ county.domestic_relations_url }}" rel="noreferrer">{{ county.name }} County domestic relations court</a></li>{% endif %}
        {% if county.juvenile_url %}<li><a href="{{ county.juvenile_url }}" rel="noreferrer">{{ county.name }} County juvenile court</a></li>{% endif %}
        {% if county.local_rules_url %}<li><a href="{{ county.local_rules_url }}" rel="noreferrer">Local rules and standard parenting-time schedule</a></li>{% endif %}
        {% if county.csea_url %}<li><a href="{{ county.csea_url }}" rel="noreferrer">{{ county.name }} County child support enforcement agency (CSEA)</a></li>{% endif %}
      </ul>
    {% endif %}

    <h2 id="which-court">Which court hears your case</h2>
    <p>In most Ohio counties, divorce, dissolution, and legal separation cases, including the custody and support issues within them, are heard by the domestic relations division of the court of common pleas. Some counties combine domestic relations with the juvenile or probate division. Custody, parenting-time, and support cases between parents who were never married to each other generally go to <a href="/resources/glossary/#juvenile-court">juvenile court</a>. Confirm with the {{ county.name }} County clerk before filing.</p>

    <h2 id="support">Child support</h2>
    <p>Child support in {{ county.name }} County is administered by the county <a href="/resources/glossary/#child-support-enforcement-agency-csea">child support enforcement agency (CSEA)</a>, usually part of the county department of job and family services. Ohio's support guidelines are in <a href="/law/orc-chapter-3119/">ORC Chapter 3119</a>.</p>

    <h2 id="safety">Protection orders</h2>
    <p>Domestic violence civil protection orders are available under <a href="/law/orc-3113-31/">ORC § 3113.31</a>. If you are in danger, call <a href="tel:911">911</a>. See <a href="/start/safety-first/">Safety first</a>.</p>

