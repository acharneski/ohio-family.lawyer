<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-brand" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>
       <span class="site-brand__seal" aria-hidden="true">§</span>
       <span class="site-brand__name">{% if ".lawyer" in site.name %}{{ site.name | replace(".lawyer", "") }}<span class="site-brand__tld">.lawyer</span>{% else %}{{ site.name }}{% endif %}</span>
      <span class="site-brand__tag">Ohio family court reform</span>
    </a>

    <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="primary-nav" hidden>
      Menu
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        {% for item in site.nav.primary %}
          {% set isCurrent = page.url and page.url.startsWith(item.url) %}
          <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="{{ 'page' if page.url == item.url else 'true' }}"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
        <li><a class="primary-nav__search" href="/search/">Search</a></li>
      </ul>
    </nav>
  </div>
</header>